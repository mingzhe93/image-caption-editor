{
  "name": "image-caption-editor",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "author": "Your Name",
  "description": "Image Caption Editor - Desktop App",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "dist": "node scripts/build-electron.js",
    "dist:win": "node scripts/build-electron.js --win"
  },
  "dependencies": {
    "next": "16.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.5",
    "electron-builder": "^26.0.12",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "tailwindcss": "^4",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.imagecaptioneditor.app",
    "productName": "Image Caption Editor",
    "asarUnpack": [
      "**/@img/**"
    ],
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/@img/**"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/image_caption_edit.ico",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "public/image_caption_edit.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "optionalDependencies": {
    "@img/sharp-darwin-x64": "^0.34.5",
    "sharp": "^0.34.5"
  }
}
